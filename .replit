modules = ["nodejs-22"]
run = "npm run build && npm start"

[env]
PORT = "8787"
TRUST_PROXY = "1"
SEED_DEMO = "1"
DB_PATH = "data/lovelocks.db"

[[ports]]
localPort = 8787
externalPort = 80

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["npm", "start"]
