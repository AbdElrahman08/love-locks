# Copy to .env — never commit real values.
# Backend mode for the web client: "local" (bundled Node API) or "supabase"
VITE_BACKEND=local
# Public base URL used when building invitation links (defaults to window.location.origin)
VITE_PUBLIC_URL=
# Supabase (only when VITE_BACKEND=supabase). The anon key is public by design; NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local API server
PORT=8787
DB_PATH=data/lovelocks.db
# Optional analytics / monitoring (disabled when empty)
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
