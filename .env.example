# Copy to .env — never commit real values.
# Backend mode for the web client: "local" (bundled Node API) or "supabase"
VITE_BACKEND=local
# Public base URL used when building invitation links (defaults to window.location.origin)
VITE_PUBLIC_URL=
# Supabase (only when VITE_BACKEND=supabase). The anon key is public by design; NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local API server
PORT=8787
# Storage: leave both URLs empty for local SQLite (DB_PATH).
# In Replit, use the dedicated name below so it can coexist with the reserved DATABASE_URL.
# Copy the Supabase Session pooler URI here, including the database password.
SUPABASE_DATABASE_URL=
# DATABASE_URL remains supported for other hosts and local setups.
DATABASE_URL=
DB_PATH=data/lovelocks.db
# Optional: PEM of Supabase's root CA to fully verify TLS (otherwise traffic is encrypted but the cert is not pinned)
DATABASE_SSL_CA=
# Answer-hashing pepper. REQUIRED in production; never change it once players have created locks.
SERVER_PEPPER=
# Contact email shown on the privacy policy and terms pages (required before a public launch)
VITE_CONTACT_EMAIL=
# Optional analytics / monitoring (disabled when empty)
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
